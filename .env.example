# Database Connection Settings
# For Local MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_password
DB_NAME=smart_campus_mobility

# For AWS RDS MySQL:
# DB_HOST=your-rds-endpoint.cxxxxxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=3306
# DB_USER=admin
# DB_PASSWORD=your_rds_password
# DB_NAME=smart_campus_mobility

# Optional Advanced Settings:
# DB_TIMEOUT=10        # Connection timeout in seconds (default: 10)
# DB_POOL_SIZE=5       # Connection pool size (default: 5)
# DB_SSL_CA=           # Path to rds-ca-bundle.pem if strict SSL verification is required
# DB_SSL_DISABLED=false
